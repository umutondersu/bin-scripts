#!/usr/bin/env python3
"""Echo NANO Subdirectory Layout Sync.

Synchronizes foobar2000 playlists to a FiiO Snowsky Echo Nano DAP using a
flat card-root layout:
- Tracks in 'Nano Excluded' are never synced (kept for the desktop only).
- Top Rated members live once in /Top Rated/ (single relocated copy).
- Other library tracks live at the card root.
- Any further playlist (Relax, ...) becomes a folder at the root holding
  duplicate copies of its members; membership is read from foobar each run.
- Zero-padded track numbering, plus a fatsort pass, keeps playback order
  correct in the Nano's File Browser (which sorts by raw directory order).
- Strips embedded cover art across common formats to optimize flash storage.
- Tracks sync state atomically using an on-card JSON manifest.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from pathlib import Path

import mutagen
from mutagen.flac import FLAC
from mutagen.id3 import ID3, ID3NoHeaderError

HOME = Path.home()
MAX_TRACKS = 8192

DEFAULT_PROFILE = HOME / "foobar2000" / "profile"
DEFAULT_SOURCE_ROOT = HOME / "Music" / "0Main"
DEFAULT_MASTER_PLAYLIST = "Library Sorted"
DEFAULT_TOP_RATED_PLAYLIST = "Top Rated"
DEFAULT_EXCLUDE_PLAYLIST = "Nano Excluded"

# Bump when title extraction logic changes, to invalidate cached titles.
TITLE_CACHE_V = 1

# Playlists that are never turned into device folders (scratch / internal lists).
IGNORED_PLAYLISTS = {
    "Library Selection",
    "Library Playback",
    "Filter Results",
    "Whole Library",
    "Recent",
    "R Top Rated",
}

GLOBAL_FILE_INDEX: dict[str, list[Path]] | None = None

# Set by the SIGINT handler; checked between files so Ctrl+C aborts cleanly at a
# safe point instead of mid-write. Mutable list to avoid `global` in the handler.
ABORT = [False]


def format_eta(seconds: int) -> str:
    """Format seconds into HH:MM:SS or MM:SS."""
    if seconds < 0 or seconds > 86400 * 7:
        return "--:--"
    hrs, remainder = divmod(seconds, 3600)
    mins, secs = divmod(remainder, 60)
    if hrs > 0:
        return f"{hrs:02d}:{mins:02d}:{secs:02d}"
    return f"{mins:02d}:{secs:02d}"


def render_progress_bar(
    current: int,
    total: int,
    prefix: str = "",
    length: int = 24,
    extra: str = "",
) -> None:
    """Render a terminal progress bar with percentage and optional stats."""
    if total <= 0:
        return
    if not sys.stdout.isatty():
        # Headless (auto-sync): emit a concise line ~every 5% so it can be
        # watched via the journal/log, instead of spamming per-track updates.
        step = max(1, total // 20)
        if current == total or current % step == 0:
            pct = current / total * 100
            count_str = f"{pct:>4.0f}% [{current}/{total}]"
            extra_str = f" | {extra}" if extra else ""
            sys.stdout.write(f"{prefix:<16} {count_str}{extra_str}\n")
            sys.stdout.flush()
        return
    percent = current / total
    filled = int(length * percent)
    bar = "█" * filled + "░" * (length - filled)
    pct_str = f"{percent * 100:>5.1f}%"
    count_str = f"[{current}/{total}]"
    extra_str = f" | {extra}" if extra else ""
    sys.stdout.write(f"\r{prefix:<16} |{bar}| {pct_str} {count_str}{extra_str}\033[K")
    sys.stdout.flush()
    if current == total:
        sys.stdout.write("\n")


def send_notification(title: str, msg: str) -> None:
    """Send a desktop notification via libnotify if available."""
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", "-a", "Echo Sync", title, msg], check=False)


def find_default_dest() -> Path | None:
    """Auto-detect mounted removable storage path on Linux and macOS."""
    user = os.environ.get("USER") or os.environ.get("LOGNAME") or HOME.name
    search_roots = [Path("/run/media") / user, Path("/media") / user, Path("/Volumes")]
    for root in search_roots:
        if root.exists() and root.is_dir():
            mounts = [p for p in root.iterdir() if p.is_dir()]
            if mounts:
                return mounts[0]
    return None


def sanitize_filename(name: str) -> str:
    """Remove filesystem-illegal characters from a filename string."""
    return re.sub(r'[\\/*?:"<>|]', "", name).strip()


def load_playlist_index(profile: Path) -> dict[str, str]:
    """Parse foobar2000 index.txt to map playlist GUIDs to playlist names."""
    index_file = profile / "playlists-v2.0" / "index.txt"
    if not index_file.exists():
        sys.exit(f"[FATAL] foobar playlist index not found: {index_file}")
    mapping: dict[str, str] = {}
    for line in index_file.read_text(encoding="utf-8-sig").splitlines():
        line = line.strip()
        if not line or ":" not in line:
            continue
        guid, name = line.split(":", 1)
        mapping[guid.strip()] = name.strip()
    return mapping


def get_global_file_index(source_root: Path) -> dict[str, list[Path]]:
    """Build and cache a filename-to-path index of the source library."""
    global GLOBAL_FILE_INDEX
    if GLOBAL_FILE_INDEX is None:
        sys.stdout.write("Building file index fallback cache... ")
        sys.stdout.flush()
        GLOBAL_FILE_INDEX = {}
        exts = {
            ".flac",
            ".mp3",
            ".m4a",
            ".ogg",
            ".opus",
            ".wav",
            ".wave",
            ".ape",
            ".aif",
            ".aiff",
        }
        for p in source_root.rglob("*"):
            if p.suffix.lower() in exts:
                GLOBAL_FILE_INDEX.setdefault(p.name.lower(), []).append(p)
        print("Done.")
    return GLOBAL_FILE_INDEX


def parse_fplite(
    profile: Path, index: dict[str, str], playlist_name: str, source_root: Path
) -> list[Path]:
    """Extract and resolve audio file paths from a foobar2000 .fplite playlist."""
    guid = next(
        (g for g, n in index.items() if n.lower() == playlist_name.lower()), None
    )
    if not guid:
        print(f"[Warning] Playlist '{playlist_name}' not found in index.")
        return []

    fplite = profile / "playlists-v2.0" / f"playlist-{guid}.fplite"
    if not fplite.exists():
        print(f"[Warning] Missing file {fplite.name}")
        return []

    tracks: list[Path] = []

    for raw in fplite.read_text(encoding="utf-8-sig").splitlines():
        line = raw.strip()
        if not line:
            continue
        entry = (
            line[len("file-relative://") :]
            if line.startswith("file-relative://")
            else line
        )
        entry = entry.replace("\\", "/")
        if "0Main/" in entry:
            entry = entry.split("0Main/", 1)[1]

        p = source_root / entry
        if p.is_file():
            tracks.append(p.resolve())
            continue

        fname = Path(entry).name.lower()
        idx_cache = get_global_file_index(source_root)
        matches = idx_cache.get(fname, [])
        if len(matches) == 1:
            tracks.append(matches[0].resolve())

    return tracks


def get_clean_title(path: Path) -> str:
    """Extract audio title tag or fallback to sanitized filename."""
    raw_title = ""
    try:
        audio = mutagen.File(path)
        if audio is not None:
            tags = getattr(audio, "tags", None)
            if tags:
                for key in ("title", "TIT2", "\xa9nam"):
                    try:
                        if key in tags:
                            val = tags[key]
                            if isinstance(val, (list, tuple)) and val:
                                raw_title = str(val[0]).strip()
                            else:
                                raw_title = str(val).strip()
                            if raw_title:
                                break
                    except Exception:
                        continue
            if not raw_title:
                try:
                    if "title" in audio:
                        raw_title = str(audio["title"][0]).strip()
                except Exception:
                    pass
    except Exception:
        pass

    used_filename_fallback = False
    if not raw_title:
        raw_title = path.stem
        used_filename_fallback = True

    clean = re.sub(r"^\d+[\s._-]+", "", raw_title).strip()
    if used_filename_fallback:
        clean = re.sub(r"^.+?\s-\s+", "", clean).strip()

    return clean or path.stem


def has_cover_art(file_path: Path) -> bool:
    """Check whether an audio file contains embedded artwork metadata."""
    suffix = file_path.suffix.lower()
    try:
        if suffix == ".flac":
            audio = FLAC(file_path)
            return bool(audio.pictures)

        if suffix in {".mp3", ".wav", ".wave", ".aif", ".aiff"}:
            tags = ID3(file_path)
            return any(k.startswith("APIC") or k.startswith("PIC") for k in tags.keys())

        if suffix in {".ogg", ".opus", ".oga"}:
            audio = mutagen.File(file_path)
            if audio is not None and getattr(audio, "tags", None):
                return any(
                    k.lower() in {"metadata_block_picture", "coverart", "coverartmime"}
                    for k in audio.tags.keys()
                )

        if suffix in {".m4a", ".mp4", ".aac", ".alac"}:
            audio = mutagen.File(file_path)
            return bool(audio and audio.tags and "covr" in audio.tags)

    except Exception:
        return False

    return False


def remove_cover_art_from_file(file_path: Path) -> bool:
    """Strip embedded cover art blocks across common audio formats."""
    suffix = file_path.suffix.lower()
    modified = False

    try:
        if suffix == ".flac":
            audio = FLAC(file_path)
            if audio.pictures:
                audio.clear_pictures()
                audio.save()
                modified = True

        elif suffix in {".mp3", ".wav", ".wave", ".aif", ".aiff"}:
            try:
                tags = ID3(file_path)
                art_keys = [
                    k
                    for k in tags.keys()
                    if k.startswith("APIC") or k.startswith("PIC")
                ]
                if art_keys:
                    for k in art_keys:
                        del tags[k]
                    tags.save(file_path)
                    modified = True
            except ID3NoHeaderError:
                pass

        elif suffix in {".ogg", ".opus", ".oga"}:
            audio = mutagen.File(file_path)
            if audio is not None and getattr(audio, "tags", None):
                art_keys = [
                    k
                    for k in audio.tags.keys()
                    if k.lower()
                    in {"metadata_block_picture", "coverart", "coverartmime"}
                ]
                if art_keys:
                    for k in art_keys:
                        del audio.tags[k]
                    audio.save()
                    modified = True

        elif suffix in {".m4a", ".mp4", ".aac", ".alac"}:
            audio = mutagen.File(file_path)
            if audio and audio.tags and "covr" in audio.tags:
                del audio.tags["covr"]
                audio.save()
                modified = True

    except Exception as exc:
        err_str = str(exc)
        if (
            "Read-only" in err_str
            or "No space" in err_str
            or "[Errno " in err_str
            or isinstance(exc, OSError)
        ):
            raise OSError(err_str) from exc
        print(f"\n[Warning] Art strip skipped on {file_path.name}: {exc}")

    return modified


def _fsync(path: Path) -> None:
    """Force file data to storage (durability before the atomic rename)."""
    with open(path, "rb") as fh:
        os.fsync(fh.fileno())


def _file_size(path: Path) -> int | None:
    try:
        return path.stat().st_size
    except OSError:
        return None


def stage_to_local(src: Path, tmp_dir: Path, tag: str, strip_art: bool) -> Path:
    """Copy src into a fast local temp, stripping art if requested; return the path."""
    staged = tmp_dir / f"stage_{tag}"
    shutil.copyfile(src, staged)
    if strip_art:
        remove_cover_art_from_file(staged)
    return staged


def place_on_card(staged: Path, final: Path, temp_path: Path) -> None:
    """Atomically move staged content to `final` via a same-filesystem temp+rename.

    Writes to a scratch temp on the card, fsyncs it, then renames it over the
    destination. The destination name therefore only ever points at a complete
    file -- an interrupted write leaves only a scratch temp, never a partial at
    the real name.
    """
    shutil.copyfile(staged, temp_path)
    _fsync(temp_path)
    try:
        if final.exists():
            final.unlink()
        os.replace(temp_path, final)
    except OSError:
        temp_path.unlink(missing_ok=True)
        raise


def save_manifest(manifest_file: Path, manifest: dict[str, dict]) -> None:
    """Atomically persist synchronization state to JSON manifest."""
    try:
        tmp_manifest = manifest_file.with_suffix(".tmp")
        tmp_manifest.write_text(
            json.dumps(manifest, separators=(",", ":")), encoding="utf-8"
        )
        tmp_manifest.replace(manifest_file)
    except OSError as exc:
        sys.exit(f"\n\n[FATAL] Failed to save manifest: {exc}")


def clean_junk_files(root: Path) -> None:
    """Clean OS-generated metadata files/dirs from the removable drive (one walk)."""
    junk_dirs = {".Spotlight-V100", ".fseventsd", ".Trashes"}
    junk_files = {".DS_Store", "Thumbs.db", ".apdisk"}
    for dirpath, dirnames, filenames in os.walk(root, topdown=True):
        for d in list(dirnames):
            if d in junk_dirs or d.startswith(".Trash-"):
                shutil.rmtree(Path(dirpath) / d, ignore_errors=True)
                dirnames.remove(d)
        for f in filenames:
            if f in junk_files or f.startswith("._"):
                try:
                    (Path(dirpath) / f).unlink(missing_ok=True)
                except OSError:
                    pass


def resolve_block_device(mountpoint: Path) -> str | None:
    """Resolve the block device backing a mount point."""
    try:
        out = subprocess.run(
            ["findmnt", "-n", "-o", "SOURCE", str(mountpoint)],
            capture_output=True,
            text=True,
            check=False,
        )
        dev = out.stdout.strip()
        return dev if dev.startswith("/dev/") else None
    except Exception:
        return None


def _sudo(args: list[str], capture: bool = False) -> subprocess.CompletedProcess:
    """Run a command under sudo.

    Uses ``-n`` when there's no terminal (e.g. auto-sync from the watcher) so it
    never hangs, relying on the scoped NOPASSWD rule for fsck.fat/fatsort. When a
    terminal is present it may prompt, preserving manual use without NOPASSWD.
    """
    cmd = ["sudo", *args]
    if not sys.stdin.isatty():
        cmd = ["sudo", "-n", *args]
    if capture:
        return subprocess.run(cmd, capture_output=True, text=True, check=False)
    return subprocess.run(cmd, check=False)


def sort_card(dest_root: Path) -> None:
    """Unmount, repair, and sort the card's directory entries; leave it unmounted."""
    dev = resolve_block_device(dest_root)
    if not dev:
        print("[Warning] Could not resolve block device; skipping directory sort.")
        return
    if not shutil.which("fatsort"):
        print("[Warning] 'fatsort' not installed; Nano folder order may be incorrect.")
        return
    if not shutil.which("sudo"):
        print("[Warning] 'sudo' not found; skipping directory sort.")
        return

    print("\nUnmounting card for directory sort...")
    if subprocess.run(["udisksctl", "unmount", "-b", dev], check=False).returncode != 0:
        print("[Warning] Failed to unmount card; skipping directory sort.")
        return

    if shutil.which("fsck.fat"):
        # Capture fsck output; only surface it on a real error (exit > 1).
        # Exit 0/1 (clean / dirty-bit auto-fixed) is silent, which avoids the
        # harmless "boot sector and its backup differ" notice printed every run.
        print("Checking filesystem...")
        fsck = _sudo(["fsck.fat", "-a", dev], capture=True)
        if "password is required" in (fsck.stderr or ""):
            print("[Warning] fsck.fat needs a password and none is available headless; skipping sort.")
            return
        if fsck.returncode > 1:
            sys.stdout.write(fsck.stdout or "")
            sys.stderr.write(fsck.stderr or "")
            print("[Warning] fsck reported errors; skipping directory sort.")
            return

    print("Sorting directory entries...")
    result = _sudo(["fatsort", "-n", dev])
    if result.returncode != 0:
        print("[Warning] fatsort did not complete; card left unmounted.")
        return
    os.sync()  # ensure the reordered directory entries are durable before unplug
    print("Card sorted and left unmounted. Safe to remove.")


def sync_nested_top_rated(
    dest_root: Path,
    master_tracks: list[Path],
    top_rated_tracks: set[Path],
    folder_members: dict[str, set[str]],
    dry_run: bool,
    force_strip: bool = False,
    keep_cover_art: bool = False,
) -> None:
    """Plan and execute incremental synchronization to destination drive.

    ``folder_members`` maps a card-folder name (at the card root) to the set of
    resolved source paths that should also have a duplicate copy there.
    """
    total_master = len(master_tracks)
    if total_master > MAX_TRACKS:
        sys.exit(
            f"[FATAL] Library has {total_master} tracks, exceeding firmware limit of {MAX_TRACKS}."
        )

    extra_count = sum(len(s) for s in folder_members.values())
    if total_master + extra_count > MAX_TRACKS:
        sys.exit(
            f"[FATAL] Card would hold {total_master + extra_count} files "
            f"(including {extra_count} playlist duplicates), exceeding the "
            f"firmware limit of {MAX_TRACKS}. Exclude more tracks from "
            f"'{DEFAULT_EXCLUDE_PLAYLIST}'."
        )

    if not dry_run:
        send_notification(
            "Echo Nano Sync", f"Sync started: {total_master} tracks to the card."
        )

    dir_root = dest_root
    dir_top = dest_root / "Top Rated"

    if not dry_run:
        try:
            dir_top.mkdir(parents=True, exist_ok=True)
        except OSError as exc:
            sys.exit(f"[FATAL] Cannot create target directories: {exc}")

    manifest_file = dir_root / ".manifest_nested.json"
    manifest: dict[str, dict] = {}
    if manifest_file.exists():
        try:
            manifest = json.loads(manifest_file.read_text(encoding="utf-8"))
        except Exception:
            manifest = {}

    current_master_set = {str(p.resolve()) for p in master_tracks}

    # 1. Prune removed/excluded tracks (canonical copy + every folder duplicate)
    stale_srcs = [src for src in manifest if src not in current_master_set]
    for src in stale_srcs:
        old_entry = manifest[src]
        stale_paths: list[Path] = []
        if old_entry.get("rel_path"):
            stale_paths.append(dir_root / old_entry["rel_path"])
        for ep in old_entry.get("extra_paths") or []:
            stale_paths.append(dir_root / ep)
        for stale_file in stale_paths:
            if stale_file.exists() and not dry_run:
                try:
                    stale_file.unlink()
                except OSError as exc:
                    sys.exit(f"\n[FATAL] Failed to delete {stale_file.name}: {exc}")
        del manifest[src]

    if stale_srcs and not dry_run:
        save_manifest(manifest_file, manifest)
        os.sync()

    def _abort() -> None:
        if ABORT[0]:
            save_manifest(manifest_file, manifest)
            os.sync()
            print("\nSync aborted - progress saved; run again to resume.")
            sys.exit(130)

    # 2. Planning
    copied = moved = stripped = 0
    move_plan: list[tuple] = []
    copy_plan: list[tuple] = []
    strip_plan: list[tuple] = []
    discard: list[Path] = []
    # Previous folder-duplicate paths per source, carried across the manifest
    # rewrite so duplicates can be renamed (not re-copied) even after an
    # interrupted run that renamed the canonical files first.
    prev_extras_map: dict[str, list[str]] = {}

    # On-card scratch dir for atomic writes (temp + rename). Wiped up front so a
    # crashed run's leftover temps never accumulate, and a file at a real
    # destination name is always complete.
    work_dir = dir_root / ".sync_tmp"
    if not dry_run:
        shutil.rmtree(work_dir, ignore_errors=True)
        work_dir.mkdir(parents=True, exist_ok=True)
        for leftover in dir_root.glob("_tmp_*"):
            leftover.unlink(missing_ok=True)

    print()
    for rank, src in enumerate(master_tracks, 1):
        _abort()
        render_progress_bar(rank, total_master, prefix="Planning")

        src_str = str(src.resolve())
        is_top = src.resolve() in top_rated_tracks
        target_folder = dir_top if is_top else dir_root

        try:
            st = src.stat()
            src_mtime = st.st_mtime
            src_size = st.st_size
        except OSError:
            src_mtime = 0.0
            src_size = None

        prev = manifest.get(src_str)
        prev_rel = prev.get("rel_path") if prev else None
        prev_path = (dir_root / prev_rel) if prev_rel else None
        prev_size = prev.get("size") if prev else None
        prev_art = prev.get("art") if prev else None
        prev_extras = (prev.get("extra_paths") if prev else None) or []
        prev_extras_map[src_str] = prev_extras

        # Title cache: reuse the stored title when the source is unchanged (saves
        # a tag read per track on every run).
        if (
            prev
            and prev.get("v") == TITLE_CACHE_V
            and prev.get("title")
            and prev.get("mtime") == src_mtime
            and prev.get("src_size") == src_size
        ):
            clean_title = prev["title"]
        else:
            clean_title = get_clean_title(src)

        filename = f"{rank:04d}. {sanitize_filename(clean_title)}{src.suffix}"
        target_path = target_folder / filename
        rel_path = f"Top Rated/{filename}" if is_top else filename

        def _entry(size: int | None, art: bool | None) -> dict:
            return {
                "rel_path": rel_path,
                "rank": rank,
                "title": clean_title,
                "mtime": src_mtime,
                "size": size,
                "art": art,
                "src_size": src_size,
                "v": TITLE_CACHE_V,
                "extra_paths": list(prev_extras),
            }

        def _cached_art(path: Path) -> bool | None:
            """Art presence if we can trust the cache (file size unchanged), else None."""
            if prev_art is not None and prev_size == _file_size(path):
                return prev_art
            return None

        def _adopt_at_target() -> None:
            """Target holds this source's complete file - adopt or schedule strip."""
            tsize = _file_size(target_path)
            art = _cached_art(target_path)
            do_strip = force_strip
            if not do_strip and not keep_cover_art:
                if art is None:
                    art = has_cover_art(target_path)  # probe once, then cache
                do_strip = art
            if do_strip:
                strip_plan.append(
                    (target_path, src_str, src_mtime, rel_path, rank, clean_title, src_size)
                )
                stripped += 1
            else:
                manifest[src_str] = _entry(tsize, art)

        prev_file = prev_path if (prev_path and prev_path.is_file()) else None

        # Trust a file parked under its recorded name only if it still matches the
        # recorded size; a corrupt/truncated old copy is discarded and rebuilt.
        prev_ok = (
            prev_file is not None
            and (prev_size is None or _file_size(prev_file) == prev_size)
        )

        if prev_ok:
            if prev_rel == rel_path:
                _adopt_at_target()  # file already at its final name
                continue
            fsize = _file_size(prev_file)
            art = _cached_art(prev_file)
            do_strip = force_strip
            if not do_strip and not keep_cover_art:
                if art is None:
                    art = has_cover_art(prev_file)  # probe once, then cache
                do_strip = art
            if do_strip:
                strip_plan.append(
                    (target_path, src_str, src_mtime, rel_path, rank, clean_title, src_size)
                )
                stripped += 1
            else:
                manifest[src_str] = _entry(fsize, art)
            # A valid file sits under its old name; rename it into place.
            move_plan.append(
                (
                    src, src_str, prev_file, target_path, rel_path, rank,
                    clean_title, src_mtime, src_size, art,
                )
            )
            moved += 1
            continue

        # A corrupt parked file (if any) is superseded - remove it during execution.
        if prev_file is not None and prev_path != target_path:
            discard.append(prev_file)

        # No valid copy under the old name. A file already at the target is this
        # track's (atomic writes guarantee it is complete) - adopt if its size
        # matches any known recording, otherwise rebuild it.
        if target_path.is_file():
            tsize = _file_size(target_path)
            if prev_size is None or tsize == prev_size:
                _adopt_at_target()
                continue

        copy_plan.append(
            (src, target_path, rel_path, src_str, src_mtime, rank, clean_title, src_size, None)
        )
        copied += 1

    print(f"Plan: {copied} to copy, {moved} to move/rename, {stripped} art strips.")
    folder_detail = ", ".join(
        f"/{n} ({len(m)})" for n, m in sorted(folder_members.items()) if m
    )
    if folder_detail:
        print(f"Folder playlists ({extra_count} duplicate copies): {folder_detail}.")

    if dry_run:
        return

    # Remove corrupt/superseded old files before placing fresh ones.
    for p in discard:
        p.unlink(missing_ok=True)

    # ---- Moves: rename each old file into its (free) destination. Every rename is
    # one atomic op into a currently-free name, so interrupting the pass leaves each
    # file either at its old name (re-moved next run) or its new name (adopted next
    # run) -- never stranded in a temp. True name collisions/cycles are re-copied.
    if move_plan:
        # Dependency order: rename a file only once its target name is free by
        # following the chain target -> move-with-that-old and emitting the chain
        # reversed. Keeps the pass O(M) instead of O(M^2) for large shifts.
        by_source = {mv[2]: mv for mv in move_plan}
        ordered_moves: list[tuple] = []
        seen: set = set()
        for mv in move_plan:
            chain = []
            cur = mv
            while cur is not None and cur[2] not in seen:
                seen.add(cur[2])
                chain.append(cur)
                cur = by_source.get(cur[3])  # move whose old name == cur's target
            ordered_moves.extend(reversed(chain))

        pending = list(ordered_moves)
        executed = []
        while True:
            _abort()
            progressed = False
            for mv in list(pending):
                _abort()
                _src, _s, old, target = mv[0], mv[1], mv[2], mv[3]
                if not old.exists():
                    pending.remove(mv); executed.append(mv); progressed = True
                elif not target.exists():
                    try:
                        old.rename(target)
                    except OSError as exc:
                        sys.exit(f"\n\n[FATAL] Move failed: {exc}")
                    pending.remove(mv); executed.append(mv); progressed = True
            if not progressed:
                break
        for mv in pending:  # collision / cycle fallback: fresh atomic copy from source
            src, _s, old, target, rel_path, rank, clean_title, src_mtime, src_size, _art = mv
            old.unlink(missing_ok=True)
            copy_plan.append(
                (src, target, rel_path, _s, src_mtime, rank, clean_title, src_size, None)
            )
        for mv in executed:
            (
                _src, src_str, _o, target, rel_path, rank,
                clean_title, src_mtime, src_size, art,
            ) = mv
            manifest[src_str] = {
                "rel_path": rel_path,
                "rank": rank,
                "title": clean_title,
                "mtime": src_mtime,
                "size": _file_size(target),
                "art": art,
                "src_size": src_size,
                "v": TITLE_CACHE_V,
                "extra_paths": prev_extras_map.get(src_str, []),
            }
        save_manifest(manifest_file, manifest)
        os.sync()

    # ---- Copies: stage locally (art stripped there), then atomic temp+rename on card.
    if copy_plan:
        total_copy_bytes = sum(s.stat().st_size for s, *_ in copy_plan)
        free_bytes = shutil.disk_usage(dest_root).free
        if total_copy_bytes > free_bytes:
            req_mb = total_copy_bytes / (1024 * 1024)
            free_mb = free_bytes / (1024 * 1024)
            sys.exit(
                f"\n[FATAL] Insufficient space: Need {req_mb:.1f} MB, but only {free_mb:.1f} MB available."
            )

        total_copies = len(copy_plan)
        total_bytes = sum(s.stat().st_size for s, *_ in copy_plan)
        transferred_bytes = 0
        start_time = time.time()

        with tempfile.TemporaryDirectory(prefix="echonano_") as tmp_dir_str:
            tmp_dir = Path(tmp_dir_str)
            for idx, (
                src, dst, rel_path, src_str, src_mtime, rank, clean_title, src_size, _art,
            ) in enumerate(copy_plan, 1):
                _abort()
                try:
                    if keep_cover_art:
                        # No stripping needed: copy straight to the card (atomic).
                        place_on_card(src, dst, work_dir / f"c{rank:05d}{src.suffix}")
                    else:
                        staged = stage_to_local(
                            src, tmp_dir, f"{rank:05d}{src.suffix}", strip_art=True
                        )
                        place_on_card(staged, dst, work_dir / f"c{rank:05d}{src.suffix}")
                except OSError as exc:
                    sys.exit(f"\n\n[FATAL] Error copying {src.name}: {exc}")

                transferred_bytes += src.stat().st_size
                elapsed = time.time() - start_time
                speed = (
                    (transferred_bytes / (1024 * 1024)) / elapsed if elapsed > 0 else 0
                )
                eta_sec = (
                    int((total_bytes - transferred_bytes) / (speed * 1024 * 1024))
                    if speed > 0
                    else 0
                )
                eta_str = format_eta(eta_sec)

                manifest[src_str] = {
                    "rel_path": rel_path,
                    "rank": rank,
                    "title": clean_title,
                    "mtime": src_mtime,
                    "size": _file_size(dst),
                    "art": False if not keep_cover_art else None,
                    "src_size": src_size,
                    "v": TITLE_CACHE_V,
                    "extra_paths": prev_extras_map.get(src_str, []),
                }
                if idx % 50 == 0 or idx == total_copies:
                    save_manifest(manifest_file, manifest)
                render_progress_bar(
                    idx,
                    total_copies,
                    prefix="Copying tracks",
                    extra=f"{speed:>4.1f} MB/s | ETA {eta_str}",
                )
        os.sync()

    # ---- Strip art in place, atomically (rewrite through scratch + rename).
    if strip_plan:
        total_strips = len(strip_plan)
        with tempfile.TemporaryDirectory(prefix="echonano_") as tmp_dir_str:
            tmp_dir = Path(tmp_dir_str)
            for idx, (
                target_path, src_str, src_mtime, rel_path, rank, clean_title, src_size,
            ) in enumerate(strip_plan, 1):
                _abort()
                if target_path.is_file():
                    try:
                        staged = stage_to_local(
                            target_path, tmp_dir, f"s{rank:05d}{target_path.suffix}", strip_art=True
                        )
                        place_on_card(staged, target_path, work_dir / f"s{rank:05d}{target_path.suffix}")
                    except OSError as exc:
                        sys.exit(
                            f"\n\n[FATAL] Error stripping art from {target_path.name}: {exc}"
                        )
                manifest[src_str] = {
                    "rel_path": rel_path,
                    "rank": rank,
                    "title": clean_title,
                    "mtime": src_mtime,
                    "size": _file_size(target_path),
                    "art": False,
                    "src_size": src_size,
                    "v": TITLE_CACHE_V,
                    "extra_paths": prev_extras_map.get(src_str, []),
                }
                if idx % 50 == 0 or idx == total_strips:
                    save_manifest(manifest_file, manifest)
                render_progress_bar(idx, total_strips, prefix="Stripping art")
        os.sync()

    # ---- Folder playlists: each folder holds exactly one copy per member.
    # Duplicates are derived from the canonical file (same basename). When a track
    # was only renumbered/renamed the existing duplicate is renamed to match (no
    # I/O) -- located via the carried extra_paths, or a content signature as a
    # fallback. Genuine changes are re-copied. Stale files are then swept.
    fcopied = frenamed = fremoved = fkept = 0
    if folder_members:
        # Previous duplicate name per (source, folder), from the carried extras.
        old_extra: dict[str, dict[str, str]] = {}
        for _s, _eps in prev_extras_map.items():
            for ep in _eps:
                pp = Path(ep)
                old_extra.setdefault(_s, {})[pp.parent.name] = pp.name

        def _sig(path: Path) -> tuple | None:
            """Cheap content fingerprint (size + first 128 KiB) for exact matching."""
            try:
                with open(path, "rb") as fh:
                    head = fh.read(131072)
                return (path.stat().st_size, hashlib.sha256(head).digest())
            except OSError:
                return None

        total_members = sum(len(m) for m in folder_members.values())
        total_bytes = 0
        for members in folder_members.values():
            for src_str in members:
                entry = manifest.get(src_str)
                if entry:
                    total_bytes += _file_size(dir_root / entry.get("rel_path", "")) or 0
        idx = 0
        transferred = 0
        fstart = time.time()
        new_extras: dict[str, list[str]] = {}

        for folder in sorted(folder_members):
            fdir = dir_root / folder
            members = folder_members[folder]
            want: dict[str, Path] = {}
            for src_str in members:
                entry = manifest.get(src_str)
                if not entry:
                    continue
                canon = dir_root / entry.get("rel_path", "")
                if canon.is_file():
                    want[canon.name] = canon
            fdir.mkdir(parents=True, exist_ok=True)
            # Existing files not already a desired name = rename candidates.
            available = {
                p.name: p for p in fdir.iterdir() if p.is_file() and p.name not in want
            }
            cand_sig: dict | None = None

            # Descending rank => uniform shifts always find a free rename target.
            ordered = sorted(
                members, key=lambda s: manifest.get(s, {}).get("rank", 0), reverse=True
            )
            for src_str in ordered:
                idx += 1
                entry = manifest.get(src_str)
                if entry:
                    canon = dir_root / entry.get("rel_path", "")
                    if canon.is_file():
                        desired = fdir / canon.name
                        csize = _file_size(canon)
                        new_extras.setdefault(src_str, []).append(f"{folder}/{canon.name}")
                        if desired.is_file() and _file_size(desired) == csize:
                            fkept += 1
                        else:
                            renamed = False
                            # 1) exact carried duplicate name
                            old_name = old_extra.get(src_str, {}).get(folder)
                            if (
                                old_name in available
                                and _file_size(available[old_name]) == csize
                                and not desired.exists()
                            ):
                                try:
                                    available[old_name].rename(desired)
                                except OSError as exc:
                                    sys.exit(f"\n[FATAL] Failed to rename folder copy: {exc}")
                                del available[old_name]
                                frenamed += 1
                                renamed = True
                            # 2) content-signature fallback (handles an interrupted run)
                            if not renamed and not desired.exists():
                                if cand_sig is None:
                                    cand_sig = {}
                                    for nm, pp in available.items():
                                        sg = _sig(pp)
                                        if sg is not None:
                                            cand_sig[sg] = nm
                                sg = _sig(canon)
                                nm = cand_sig.get(sg) if sg is not None else None
                                if nm is not None and nm in available:
                                    try:
                                        available[nm].rename(desired)
                                    except OSError as exc:
                                        sys.exit(f"\n[FATAL] Failed to rename folder copy: {exc}")
                                    del available[nm]
                                    cand_sig.pop(sg, None)
                                    frenamed += 1
                                    renamed = True
                            # 3) copy
                            if not renamed:
                                temp_path = work_dir / f"e{canon.name[:40]}"
                                try:
                                    shutil.copyfile(canon, temp_path)
                                    _fsync(temp_path)
                                    if desired.exists():
                                        desired.unlink()
                                    os.replace(temp_path, desired)
                                except OSError as exc:
                                    temp_path.unlink(missing_ok=True)
                                    sys.exit(
                                        f"\n\n[FATAL] Error writing folder copy {desired.name}: {exc}"
                                    )
                                fcopied += 1
                                transferred += csize or 0

                elapsed = time.time() - fstart
                speed = (transferred / (1024 * 1024)) / elapsed if elapsed > 0 else 0
                eta_sec = (
                    int((total_bytes - transferred) / (speed * 1024 * 1024))
                    if speed > 0
                    else 0
                )
                render_progress_bar(
                    idx,
                    total_members,
                    prefix="Folder copies",
                    extra=f"{speed:>4.1f} MB/s | ETA {format_eta(eta_sec)}",
                )

            for p in list(fdir.iterdir()):
                if p.is_file() and p.name not in want:
                    try:
                        p.unlink()
                    except OSError as exc:
                        sys.exit(f"\n[FATAL] Failed to delete {p.name}: {exc}")
                    fremoved += 1
            if not any(fdir.iterdir()):
                fdir.rmdir()  # tidy empty folders (e.g. playlist emptied/removed)

        # Record the current duplicate locations for exact renames next run.
        for src_str, entry in manifest.items():
            entry["extra_paths"] = sorted(new_extras.get(src_str, []))
        os.sync()
        print(
            f"Folder copies: {fcopied} copied, {frenamed} renamed, "
            f"{fremoved} removed, {fkept} kept."
        )

    clean_junk_files(dir_root)
    shutil.rmtree(work_dir, ignore_errors=True)
    save_manifest(manifest_file, manifest)

    print("\nFlushing filesystem write buffers to SD card...")
    os.sync()

    print(f"Sync complete: {len(manifest)} tracks active on card.")
    sort_card(dest_root)
    send_notification(
        "Echo Nano Sync", f"Sync complete: {len(manifest)} tracks active."
    )


def _sigint_handler(sig: int, frame: object) -> None:
    """First Ctrl+C requests a clean stop at the next file boundary; a second one quits."""
    if ABORT[0]:
        sys.exit(130)
    ABORT[0] = True
    sys.stdout.write("\nInterrupt received - finishing the current file, then stopping...\n")
    sys.stdout.flush()


def main() -> int:
    """CLI entrypoint."""
    signal.signal(signal.SIGINT, _sigint_handler)
    start_time = time.time()
    default_dest = find_default_dest()

    ap = argparse.ArgumentParser(description="Echo NANO Subdirectory Layout Sync")
    ap.add_argument(
        "--dry-run", action="store_true", help="preview actions without writing"
    )
    ap.add_argument(
        "--limit", type=int, default=None, help="sync only the first N tracks"
    )
    ap.add_argument(
        "--keep-cover-art",
        action="store_true",
        help="do not strip embedded cover art during sync",
    )
    ap.add_argument(
        "--force-strip",
        action="store_true",
        help="force re-strip art on all files in-place",
    )
    ap.add_argument(
        "--master-playlist",
        default=DEFAULT_MASTER_PLAYLIST,
        help="master full library playlist name",
    )
    ap.add_argument(
        "--top-rated-playlist",
        default=DEFAULT_TOP_RATED_PLAYLIST,
        help="favorites playlist name",
    )
    ap.add_argument(
        "--exclude-playlist",
        default=DEFAULT_EXCLUDE_PLAYLIST,
        help="playlist whose tracks are never synced to the card",
    )
    ap.add_argument(
        "--ignore-playlist",
        action="append",
        default=[],
        metavar="NAME",
        help="ignore this playlist (never a device folder); repeatable",
    )
    ap.add_argument(
        "--profile", default=str(DEFAULT_PROFILE), help="foobar2000 profile directory"
    )
    ap.add_argument(
        "--source-root",
        default=str(DEFAULT_SOURCE_ROOT),
        help="local music root directory",
    )
    ap.add_argument(
        "--dest",
        default=str(default_dest) if default_dest else None,
        help="mount path of SD card (auto-detected if omitted)",
    )
    args = ap.parse_args()

    if not args.dest:
        sys.exit(
            "[FATAL] Could not auto-detect SD card mount. Please provide --dest /path/to/disk"
        )

    dest_root = Path(args.dest)
    if not dest_root.exists():
        sys.exit(f"[FATAL] Destination not mounted: {dest_root}")

    profile = Path(args.profile)
    source_root = Path(args.source_root)

    print(f"Target destination: {dest_root}")
    index = load_playlist_index(profile)

    master_all = parse_fplite(profile, index, args.master_playlist, source_root)
    if not master_all:
        sys.exit(
            f"[FATAL] No tracks found in master playlist '{args.master_playlist}'. Aborting."
        )

    # Tracks in the exclude playlist stay in foobar but never reach the card.
    excluded = {
        str(p.resolve())
        for p in parse_fplite(profile, index, args.exclude_playlist, source_root)
    }
    master_tracks = [t for t in master_all if str(t.resolve()) not in excluded]
    if not master_tracks:
        sys.exit("[FATAL] Master playlist is empty after applying exclusions. Aborting.")
    if excluded:
        print(f"Excluded {len(excluded)} track(s) from the card ('{args.exclude_playlist}').")

    if args.limit:
        print(f"[Test Mode] Limiting master playlist to first {args.limit} tracks.")
        master_tracks = master_tracks[: args.limit]

    master_set = {str(t.resolve()) for t in master_tracks}

    top_rated_set = {
        p.resolve()
        for p in parse_fplite(profile, index, args.top_rated_playlist, source_root)
        if str(p.resolve()) in master_set
    }

    # Folder playlists: every playlist except master / Top Rated / the exclude
    # list / the blacklist. Members get duplicate copies on the card.
    ignored = set(IGNORED_PLAYLISTS) | set(args.ignore_playlist)
    specials = {
        args.master_playlist.lower(),
        args.top_rated_playlist.lower(),
        args.exclude_playlist.lower(),
    }
    folder_members: dict[str, set[str]] = {}
    for name in set(index.values()):
        if name.lower() in specials or name in ignored:
            continue
        folder_name = sanitize_filename(name)
        if not folder_name:
            continue
        members = {
            str(p.resolve())
            for p in parse_fplite(profile, index, name, source_root)
            if str(p.resolve()) in master_set
        }
        # Keep the folder even if currently empty so stale copies get swept out.
        folder_members[folder_name] = members

    sync_nested_top_rated(
        dest_root,
        master_tracks,
        top_rated_set,
        folder_members,
        args.dry_run,
        force_strip=args.force_strip,
        keep_cover_art=args.keep_cover_art,
    )

    elapsed = int(time.time() - start_time)
    print(f"\nTotal time: {format_eta(elapsed)}.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
